# --- Secrets and credentials (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
.aws/
credentials
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Local data (Postgres, SQLite, LocalStack) ---
pgdata/
*.sqlite
*.sqlite3
*.db
.localstack/
localstack-volume/
volume/

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
# keep .terraform.lock.hcl committed

# --- Logs and temp files ---
*.log
tmp/
.tmp/

# --- Editors and OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Claude Code local settings ---
.claude/settings.local.json
